titlecut [" ","BLACK IN", 1]
_camera = "camera" camcreate [0,0,0]
_camera cameraeffect ["internal","back"]
_camera camPrepareTarget [14979.39,12216.138,22.89]
_camera camPreparePos [15115.31,12292.87,3.51]
